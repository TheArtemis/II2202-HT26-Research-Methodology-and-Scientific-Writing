# Example Ansible inventory (YAML). Terraform apply writes inventory.ini instead;
# scripts accept either inventory.ini or inventory/hosts.yml.
all:
  children:
    workers:
      hosts:
        worker-00:
          ansible_host: 203.0.113.10
          ansible_user: ubuntu
          worker_index: 0
          from_trial: 0
          limit_trials: 180
          instance_id: i-example000
        worker-01:
          ansible_host: 203.0.113.11
          ansible_user: ubuntu
          worker_index: 1
          from_trial: 180
          limit_trials: 180
          instance_id: i-example001
        worker-02:
          ansible_host: 203.0.113.12
          ansible_user: ubuntu
          worker_index: 2
          from_trial: 360
          limit_trials: 180
          instance_id: i-example002
        worker-03:
          ansible_host: 203.0.113.13
          ansible_user: ubuntu
          worker_index: 3
          from_trial: 540
          limit_trials: 180
          instance_id: i-example003
        worker-04:
          ansible_host: 203.0.113.14
          ansible_user: ubuntu
          worker_index: 4
          from_trial: 720
          limit_trials: 180
          instance_id: i-example004
      vars:
        ansible_python_interpreter: /usr/bin/python3
        campaign_id: full-YYYYMMDD
        results_bucket: ii2202-experiments-ACCOUNT
        s3_prefix: campaigns/full-YYYYMMDD/
        aws_region: eu-north-1
