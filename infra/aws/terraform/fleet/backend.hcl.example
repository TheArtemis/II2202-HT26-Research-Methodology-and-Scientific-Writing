# Generated by bootstrap outputs — `make bootstrap` writes backend.hcl automatically.
# Manual fallback:
#   cd ../bootstrap && terraform apply
#   terraform output -raw backend_hcl_snippet > ../fleet/backend.hcl
#
# Then:
#   terraform init -backend-config=backend.hcl

bucket         = "ii2202-experiments-ACCOUNT_ID"
key            = "tfstate/fleet/terraform.tfstate"
region         = "eu-north-1"
dynamodb_table = "ii2202-terraform-locks"
encrypt        = true
